views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("3-Database/11 - Resources")
    columns:
      - file.name: { type: "title" }
      - URL: { type: "str" }
      - Type: { type: "select", source: "3-Database/11 - Resources/_Types" }
      - Area: { type: "relation", source: "3-Database/01 - Areas" }
      - Course: { type: "relation", source: "3-Database/07 - Courses" }
