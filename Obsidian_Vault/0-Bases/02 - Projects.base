views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("3-Database/02 - Projects")
    columns:
      - file.name: { type: "title" }
      - Status: { type: "select", source: "1-Meta/0-Definitions/Status" }
      - Priority: { type: "select", source: "1-Meta/0-Definitions/Priority" }
      - Area: { type: "relation", source: "3-Database/01 - Areas" }
      - Goal Relation: { type: "relation", source: "3-Database/05 - Goals" }
      - Progress: { type: "number" }
      - Archive: { type: "bool" }
