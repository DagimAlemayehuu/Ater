views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("3-Database/01 - Tasks")
    columns:
      - file.name: { type: "title" }
      - Done: { type: "bool" }
      - Priority: { type: "select", source: "1-Meta/0-Definitions/Priority" }
      - Status: { type: "select", source: "1-Meta/0-Definitions/Status" }
      - Project Relation: { type: "relation", source: "3-Database/02 - Projects" }
      - Goal Relation: { type: "relation", source: "3-Database/05 - Goals" }
      - Assignment Relation: { type: "relation", source: "3-Database/03 - Assignments" }
      - Area: { type: "relation", source: "3-Database/01 - Areas" }
      - Due Date: { type: "date" }
      - Task Type: { type: "str" }
