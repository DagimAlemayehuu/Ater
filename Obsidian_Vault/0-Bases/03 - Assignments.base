views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("3-Database/03 - Assignments")
    columns:
      - file.name: { type: "title" }
      - Course: { type: "relation", source: "3-Database/07 - Courses" }
      - Status: { type: "select", source: "1-Meta/0-Definitions/Status" }
      - Priority: { type: "select", source: "1-Meta/0-Definitions/Priority" }
      - Due Date: { type: "date" }
      - Progress: { type: "number" }
      - Archive: { type: "bool" }
