views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("3-Database/04 - Exams")
    columns:
      - file.name: { type: "title" }
      - Course: { type: "relation", source: "3-Database/07 - Courses" }
      - Exam Date: { type: "date" }
      - Total Score: { type: "number" }
      - Scored: { type: "number" }
      - Type of Exam: { type: "select", source: "3-Database/04 - Exams/_Types" }
