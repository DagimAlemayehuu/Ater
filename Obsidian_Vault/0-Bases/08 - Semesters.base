views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("3-Database/08 - Semesters")
    columns:
      - file.name: { type: "title" }
      - Year: { type: "relation", source: "3-Database/09 - Years" }
      - Start Date: { type: "date" }
      - End Date: { type: "date" }
