{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ater",
  "version": "0.8.4",
  "identifier": "com.dagim.ater",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm --filter @ater/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "Ater",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https://*.supabase.co ipc: asset: tauri:; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: asset:; frame-src 'self' http://127.0.0.1:* http://localhost:*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../api/onnx_model",
      "../../../Ater.md"
    ],
    "externalBin": [
      "binaries/ater-api"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4NkNCRTVENTBEM0RCMEUKUldRTzI5TlFYYjVzMkw2bEhxeXlzdUJtbVBTSWxFTTFlaXN4ZFlvUnIyMVJicGJtTVJnTFQ4ZXEK",
      "endpoints": [
        "https://github.com/DagimAlemayehuu/Ater_Releases/releases/latest/download/update.json"
      ]
    }
  }
}
