{
    "mcpServers": {
        "stitch": {
            "command": "npx",
            "args": [
                "-y",
                "mcp-remote",
                "https://stitch.googleapis.com/mcp",
                "--header",
                "X-Goog-Api-Key: <STITCH_API_KEY>"
            ]
        },
        "shadcn": {
            "command": "npx",
            "args": [
                "shadcn@latest",
                "mcp"
            ]
        }
    }
}
