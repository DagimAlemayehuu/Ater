# Ater - Environment Variable Template
# Copy this file to .env and populate with your values.
# NEVER commit .env to source control.

# --- AI API Keys (Primary reasoning tiers) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Third Party Integrations ---
NOTION_API_KEY=

# --- Paths (Absolute paths required) ---
OBSIDIAN_VAULT_PATH=

# --- Python Sidecar Configuration ---
API_HOST=127.0.0.1
API_PORT=8765

# --- Mobile Specific (Native Bridge) ---
# Note: Mobile keys are managed via the native Scriptable config UI.
# These are provided for local dev parity.
MOBILE_AUTO_DEPLOY=false
