# Ater - Environment Variable Template
# Copy this file to apps/desktop/.env and populate with your values.
# NEVER commit .env to source control.

# --- Desktop App (Vite build-time vars, prefix REQUIRED) ---
# These are embedded at build time by Vite and are safe for publishable keys.
VITE_SUPABASE_URL=https://ckqjwsmdbspmquxbdrgb.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_yLvi9672bmTWPM6L3fvKAA_6ULlJ_dQ

# --- Python API Sidecar (Server-side, not exposed to frontend) ---
API_HOST=127.0.0.1
API_PORT=8765

# --- Python AI Keys (Used by sidecar via config store, not build-time) ---
# These are configured by the user in the app settings, not here.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# --- GitHub Actions Secrets Required for Release ---
# TAURI_PRIVATE_KEY   - Minisign private key for updater signatures
# TAURI_KEY_PASSWORD  - Password for the private key
# RELEASE_PAT         - GitHub Personal Access Token with repo + write:packages scopes
#                       Needs access to DagimAlemayehuu/Ater_Releases repo
